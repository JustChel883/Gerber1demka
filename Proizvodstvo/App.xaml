<Application x:Class="Proizvodstvo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        
        <SolidColorBrush x:Key="MainBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondBg" Color="#BBDCFA"/>
        <SolidColorBrush x:Key="AccentColor" Color="#0C4882"/>

        
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Bahnschrift Light SemiCondensed"/>
        </Style>

        
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>