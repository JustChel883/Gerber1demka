<Window x:Class="Proizvodstvo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список заявок партнеров" Height="600" Width="850" Background="{StaticResource MainBg}" Icon="C:\Users\Пользователь\Desktop\proga\new_tecnology.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Image Source="C:\Users\Пользователь\Desktop\proga\new_tecnology.png" Width="60" Height="60" Margin="0,0,15,0"/>
            <TextBlock Text="Заявки партнеров" FontSize="24" VerticalAlignment="Center" Foreground="{StaticResource AccentColor}"/>
        </StackPanel>

        <ListView x:Name="RequestsList" Grid.Row="1" Background="{StaticResource MainBg}" MouseDoubleClick="RequestsList_MouseDoubleClick" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#999999" BorderThickness="1" Margin="5" Padding="15" Width="780" Background="{StaticResource MainBg}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding TypeAndName}" FontSize="18" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Address}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Phone}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Rating, StringFormat='Рейтинг: {0}'}" FontSize="14"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding TotalCost, StringFormat='\{0:N0\}'}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <!-- Убираем стандартные стили выделения для большего сходства с макетом -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Button Content="Добавить заявку" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,20,0" Click="BtnAdd_Click"/>
    </Grid>
</Window>